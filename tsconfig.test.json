{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    "outDir": "dist-test",
    "rootDir": "test",
    "declaration": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"],
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["test/**/*.test.ts"]
}
